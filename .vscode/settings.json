{
    "runOnSave.commands": [
        {
            "match": "data\\\\contests\\.yaml",
            "command": "docker run --rm -v ${workspaceFolder}:/app -w /app node:lts node .vscode/yamlToJson.js data/contests.yaml assets/data/${fileBasenameNoExtension}.json",
            "runIn": "backend",
            "runningStatusMessage": "jsonify ${fileBasenameNoExtension}",
        }
    ]
}